# Upstash Redis REST API credentials — from the Upstash console, "REST API" tab
# for your database (not the ioredis/TCP connection string).
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional — Render sets PORT itself; only needed for local overrides.
PORT=3000
